#!/bin/sh
# Ask the broker for what this Agent was given, and put it where a shell finds it.
#
# The credentials are sealed under the Tenant's Ledger Key Ring and live on the
# host as ciphertext. They are deliberately not passed as container environment:
# `podman inspect` prints that to anyone who can run it, and a value handed over
# at creation outlives every reason it was handed over. So the Runner asks for
# them at start, over its own private network, and the broker answers only while
# the chain still says this Agent may act.
#
# Which means a revoked Agent loses them on its next start, from the same
# transaction that stops it spending — there is nothing here to go and delete.
#
# Written to a tmpfs so they never touch a disk, and read by the login shell.
set -eu

: "${HARNESS_BROKER:?HARNESS_BROKER is required}"

out=/run/harness/env
mkdir -p /run/harness
: > "$out"
chmod 600 "$out"

# HARNESS_BROKER is a URL already; tolerate a bare host:port too, since that is
# what one would type by hand when testing.
broker="${HARNESS_BROKER%/}"
case "$broker" in http://*|https://*) ;; *) broker="http://$broker" ;; esac

# The broker binds a Tenant's gateway, and that gateway only exists once a
# container is running on the network — so at boot the Runner is up before the
# broker is, every time. Waiting a little is the difference between an Agent
# that has its credentials and one that quietly does not.
# The timeout is generous on purpose. Answering means opening the ring, which
# runs wallet-cli, and naming the caller, which runs several podman inspects —
# comfortably more than a few seconds on a small box. Five was too tight and
# produced a timeout that read exactly like a broker that was not there.
# Eight tries was a budget in name only. A broker that is not listening yet
# refuses the connection immediately, so those eight attempts cost the sleeps
# alone — forty seconds — while the broker binds a Tenant gateway on a thirty
# second rescan and then has to open the ring. Losing that race leaves an
# agent running with no credentials and no way to notice, which is what
# "not logged in" looks like from inside. Two minutes covers it.
answer=""
i=0
while [ $i -lt 24 ]; do
    if answer=$(curl -fsS -m 30 -X POST "${broker}/secrets" 2>/dev/null); then break; fi
    answer=""
    i=$((i + 1))
    sleep 5
done

if [ -z "$answer" ]; then
    echo "harness: the broker did not answer; the agent starts without its secrets" >&2
    exit 0
fi

# Stdlib python, like everything else in the login path: the image has it, and
# a JSON parser written in sh is a bug waiting to be found by a value with a
# quote in it. The answer arrives on stdin so it is never an argument, which
# would put it in the process table for anyone running `ps`.
printf '%s' "$answer" | python3 -c '
import json, shlex, sys

out = sys.argv[1]
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
if not isinstance(data, dict) or "error" in data:
    sys.exit(0)

with open(out, "w") as f:
    for name, value in data.items():
        # The name was checked when it was sealed; the value is quoted here
        # because it is arbitrary and this file is sourced by a shell.
        if name.replace("_", "").isalnum():
            f.write("export %s=%s\n" % (name, shlex.quote(str(value))))
' "$out" || exit 0

n=$(grep -c '^export ' "$out" 2>/dev/null || true)
[ -n "${n:-}" ] && [ "$n" -gt 0 ] && echo "harness: $n secret(s) opened for this agent"
chown runner:runner "$out" 2>/dev/null || true
exit 0
