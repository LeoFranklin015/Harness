# A Runner: the container an Agent actually lives in.
#
# Its sshd asks ENS who may log in, so shell access answers to the same
# authority as spending. Nothing here holds a list of authorized keys — the
# chain is asked on every connection.
FROM docker.io/library/alpine:3.21

# node and npm are here for Claude Code, which is what makes this a machine an
# agent can actually think on rather than only spend from. It is installed
# whether or not this Tenant asked for it — the image is shared, and the thing
# that decides is whether a credential was sealed for this Agent.
# bash, because an agent that cannot run a command is a chat window. Claude
# Code and Codex both refuse to use their shell tool without it — "No suitable
# shell found" — and busybox ash does not satisfy them. Login shells stay
# /bin/sh; this is only so the tools have something they will accept.
RUN apk add --no-cache openssh-server python3 tailscale nodejs npm git curl bash \
 && adduser -D -s /bin/sh runner \
 # `adduser -D` leaves the account locked ("!" in shadow), and sshd refuses a
 # locked account even for public-key auth. The Agent has no password at all —
 # "*" says exactly that, where "!" says "disabled".
 && sed -i 's/^runner:!/runner:*/' /etc/shadow \
 && mkdir -p /etc/harness

# The hook runs inside sshd's login path, so it is stdlib-only python: nothing
# to install, nothing that can be missing when someone needs to get in.
COPY harness-authorized-keys /usr/local/bin/harness-authorized-keys
RUN chown root:root /usr/local/bin/harness-authorized-keys \
 && chmod 755 /usr/local/bin/harness-authorized-keys

# The host key is generated outside and copied in, never generated here.
# `ssh-keygen -A` only creates keys that do not already exist, so this survives
# it — and it means ENS can publish the key before the Runner is ever
# reachable, leaving no window in which a client has to trust on first use.
COPY ssh_host_ed25519_key /etc/ssh/ssh_host_ed25519_key
COPY ssh_host_ed25519_key.pub /etc/ssh/ssh_host_ed25519_key.pub
RUN chmod 600 /etc/ssh/ssh_host_ed25519_key && chmod 644 /etc/ssh/ssh_host_ed25519_key.pub

# Which Agent this Runner is. sshd gives AuthorizedKeysCommand almost no
# environment, so the name is a file rather than a variable.
COPY name /etc/harness/name

COPY sshd_config /etc/ssh/sshd_config

# tailscaled chmods its state directory on startup, and chmod on a directory you
# do not own needs CAP_FOWNER — which this container deliberately lacks. The
# alpine package ships the directory owned by uid 100, and a named volume copies
# that ownership up on first start, so it is fixed here rather than after.
RUN mkdir -p /var/lib/tailscale && chown root:root /var/lib/tailscale && chmod 700 /var/lib/tailscale

# The Agent itself. Stdlib python, because it needs no key and therefore no
# crypto library — everything it would have signed with lives in the broker.
COPY agent.py /usr/local/bin/agent
RUN chmod 755 /usr/local/bin/agent

# Both, because people have one or the other and rarely both. Which one starts
# is decided per Agent by HARNESS_BRAIN, sealed alongside the credential it
# needs, so a machine only ever launches something it can authenticate.
RUN npm install -g @anthropic-ai/claude-code @openai/codex && npm cache clean --force

# What the agent knows about this machine before anyone tells it anything: how
# x402 works here, that it cannot sign and must ask the broker, where the
# ceiling comes from, and why wallet-cli lives on the host. Claude Code reads
# CLAUDE.md from the working directory; Codex reads AGENTS.md.
# What a fresh home starts as.
#
# It lives here rather than in /home/runner because the home itself is a tmpfs:
# the root filesystem is read-only, and a CLI that cannot write its own config
# asks its first-run questions on every single launch — theme, then trust, then
# theme again — which is unusable. A tmpfs makes it writable, and mounting one
# would hide anything the image had put there, so the image seeds it instead and
# the entrypoint copies it in.
#
# Wiped on restart, which is the right side to err on: whatever a CLI caches
# about who it is goes with it, so a revoked Agent does not quietly keep working
# from a credential it wrote down earlier.
COPY CLAUDE.md /etc/harness/skel/CLAUDE.md
COPY skel/ /etc/harness/skel/
RUN cp /etc/harness/skel/CLAUDE.md /etc/harness/skel/AGENTS.md \
 && mkdir -p /etc/harness/skel/.codex

# A plan token is enough for `claude -p` and not for the interactive UI, which
# reads a credentials file and otherwise says "Not logged in" at somebody with
# no browser to log in with.
COPY brain-login /usr/local/bin/brain-login
RUN chmod 755 /usr/local/bin/brain-login

# Paying for something, without a key. The one privileged step is a request to
# the broker, so this is the tool rather than a paragraph telling an agent to
# hand-roll the same three calls.
COPY x402-fetch /usr/local/bin/x402-fetch
RUN chmod 755 /usr/local/bin/x402-fetch

COPY fetch-secrets /usr/local/bin/fetch-secrets
RUN chmod 755 /usr/local/bin/fetch-secrets

# What the Agent was given, put where a login shell will find it. The file is
# on a tmpfs and is written at start by fetch-secrets, so it is absent until
# the broker has said this Agent may still act — and absent again after a
# restart if the chain has changed its mind.
COPY profile.sh /etc/profile.d/harness.sh
RUN chmod 644 /etc/profile.d/harness.sh

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh

EXPOSE 22
CMD ["/usr/local/bin/entrypoint.sh"]
