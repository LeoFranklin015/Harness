#!/usr/bin/env python3
"""Ask the Ledger side of the house.

    ledger limits                     what you may still spend, from the chain
    ledger ask "<what>" <usd> [why]   ask the owner for something you may not do
    ledger yields [network]           live yield rates, from wallet-cli
    ledger token <network> <address>  what token that address is
    ledger token-by-id <id>           the full details of a token id

wallet-cli runs on the host, not here. Its platform binary will not run on this
image, and more to the point an Agent has no member key and no device, so most
of it would refuse anyway. What is left is the part that needs neither — live
rates and token resolution — and the broker lends it over the same socket that
lends everything else, while the chain still says you may act.

What you cannot do from here, by construction rather than by policy: `send`,
`swap execute`, `earn deposit`, and anything under `ring`. Those need the
person's hardware wallet. `ledger yields` prints a Ledger Live deeplink for
each opportunity — proposing one to a human is the whole move.

Standard library only.
"""

import json
import os
import sys
import urllib.error
import urllib.request

BROKER = os.environ.get("HARNESS_BROKER", "http://10.89.0.1:8402").rstrip("/")
if not BROKER.startswith(("http://", "https://")):
    BROKER = f"http://{BROKER}"


def ask(path, payload=None):
    data = json.dumps(payload or {}).encode()
    req = urllib.request.Request(
        f"{BROKER}{path}", data=data, headers={"content-type": "application/json"}
    )
    try:
        with urllib.request.urlopen(req, timeout=120) as r:
            return json.loads(r.read())
    except urllib.error.HTTPError as e:
        try:
            why = json.loads(e.read())["error"]
        except Exception:
            why = f"HTTP {e.code}"
        print(f"ledger: {why}", file=sys.stderr)
        raise SystemExit(2)
    except urllib.error.URLError as e:
        print(f"ledger: cannot reach the broker at {BROKER}: {e.reason}", file=sys.stderr)
        raise SystemExit(3)


def limits():
    d = ask("/limits")
    print(f"{d['agent']}")
    print(f"  ceiling  ${d['capUsd']:.2f} per window")
    print(f"  spent    ${(int(d['spent']) / 1e6):.2f}")
    print(f"  left     ${d['leftUsd']:.2f}")
    print(f"  expires  {d['expires']}")


def ask_for(want, usd, why=""):
    """Say what you need and stop. This grants nothing and is not meant to."""
    d = ask("/ask", {"want": want, "usd": usd, "why": why})
    print(f"recorded as {d['id']}")
    print(f"  {d['note']}")
    print("  Do not retry the action. Wait, or carry on with something else.")


def yields(network=None):
    d = ask("/ledger", {"cmd": "yields", **({"network": network} if network else {})})
    rows = d.get("yields") or []
    # Some rows carry no rate; they are not opportunities, they are noise.
    rated = [y for y in rows if (y.get("interestValue") or "").strip()]
    rated.sort(key=lambda y: -float(y["interestValue"]))
    if not rated:
        print("no rated opportunities")
        return
    print(f"{len(rated)} opportunities, best first:")
    for y in rated:
        rate = float(y["interestValue"]) * 100
        print(f"  {rate:6.2f}% {y.get('interestType','?'):4} {y.get('provider','?'):9} "
              f"{y.get('network','?'):9} {y.get('depositToken','?')}")
        if y.get("deeplink"):
            print(f"           {y['deeplink']}")


def main():
    if len(sys.argv) < 2:
        print(__doc__.strip().split("\n\n")[1])
        raise SystemExit(1)

    what = sys.argv[1]
    if what == "limits":
        limits()
    elif what == "yields":
        yields(sys.argv[2] if len(sys.argv) > 2 else None)
    elif what == "ask":
        if len(sys.argv) < 4:
            raise SystemExit('usage: ledger ask "<what you need>" <usd> [why]')
        try:
            usd = float(sys.argv[3])
        except ValueError:
            raise SystemExit("the amount must be a number of dollars")
        ask_for(sys.argv[2], usd, sys.argv[4] if len(sys.argv) > 4 else "")
    elif what == "token":
        if len(sys.argv) < 4:
            raise SystemExit("usage: ledger token <network> <address>")
        print(json.dumps(ask("/ledger", {"cmd": "token", "network": sys.argv[2], "address": sys.argv[3]}), indent=2))
    elif what == "token-by-id":
        if len(sys.argv) < 3:
            raise SystemExit("usage: ledger token-by-id <id>")
        print(json.dumps(ask("/ledger", {"cmd": "token-by-id", "id": sys.argv[2]}), indent=2))
    else:
        raise SystemExit(f"ledger: no such command {what!r}")


if __name__ == "__main__":
    main()
