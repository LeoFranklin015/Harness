#!/usr/bin/env python3
"""Ask the Ledger side of the house.

    ledger limits                     what you may still spend, from the chain
    ledger send <address> <usd> [why] move USDC; if the ceiling says no, it
                                      puts the payment to the owner instead
    ledger ask "<what>" <usd> [why]   ask the owner for something you may not do
    ledger yields [network]           live yield rates, from wallet-cli
    ledger token <network> <address>  what token that address is
    ledger token-by-id <id>           the full details of a token id

wallet-cli runs on the host, not here. Its platform binary will not run on this
image, and more to the point an Agent has no member key and no device, so most
of it would refuse anyway. What is left is the part that needs neither — live
rates and token resolution — and the broker lends it over the same socket that
lends everything else, while the chain still says you may act.

What you cannot do from here, by construction rather than by policy: `send`,
`swap execute`, `earn deposit`, and anything under `ring`. Those need the
person's hardware wallet. `ledger yields` prints a Ledger Live deeplink for
each opportunity — proposing one to a human is the whole move.

Standard library only.
"""

import json
import os
import re
import sys
import urllib.error
import urllib.request

BROKER = os.environ.get("HARNESS_BROKER", "")
if not BROKER:
    # No default. The old one named a fixed gateway, which is another tenant's
    # door on any machine but the first — and asking at the wrong door gets a
    # refusal that reads like a permissions problem rather than a missing
    # variable. Saying so plainly costs one line and an hour of confusion.
    print("harness: HARNESS_BROKER is not set, so there is no broker to ask.",
          file=sys.stderr)
    print("  A login shell should get it from /etc/profile.d/harness-env.sh.",
          file=sys.stderr)
    raise SystemExit(3).rstrip("/")
if not BROKER.startswith(("http://", "https://")):
    BROKER = f"http://{BROKER}"


def post_json(url, payload, timeout):
    """POST somewhere that is not the broker.

    A failure carries its reason in the body, and throwing that away leaves
    "HTTP Error 502" — which says something answered and nothing about why,
    and sends a person looking in the wrong place.
    """
    req = urllib.request.Request(
        url, data=json.dumps(payload).encode(),
        headers={"content-type": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read())
    except urllib.error.HTTPError as e:
        try:
            raise RuntimeError(json.loads(e.read()).get("error") or f"HTTP {e.code}")
        except (ValueError, AttributeError):
            raise RuntimeError(f"HTTP {e.code}")


def ask(path, payload=None):
    data = json.dumps(payload or {}).encode()
    req = urllib.request.Request(
        f"{BROKER}{path}", data=data, headers={"content-type": "application/json"}
    )
    try:
        with urllib.request.urlopen(req, timeout=360) as r:
            return json.loads(r.read())
    except urllib.error.HTTPError as e:
        try:
            why = json.loads(e.read())["error"]
        except Exception:
            why = f"HTTP {e.code}"
        print(f"ledger: {why}", file=sys.stderr)
        # The status travels with the exit: the caller has to tell "short of
        # headroom", which is worth putting to a person, from every other
        # refusal, which is not.
        stop = SystemExit(2)
        stop.status = e.code
        raise stop
    except urllib.error.URLError as e:
        print(f"ledger: cannot reach the broker at {BROKER}: {e.reason}", file=sys.stderr)
        raise SystemExit(3)


def limits():
    d = ask("/limits")
    print(f"{d['agent']}")
    print(f"  ceiling  ${d['capUsd']:.2f} per window")
    print(f"  spent    ${(int(d['spent']) / 1e6):.2f}")
    print(f"  left     ${d['leftUsd']:.2f}")
    print(f"  expires  {d['expires']}")


def send_to(address, usd, why=""):
    """Move money, or put the payment in front of somebody who can.

    Over the ceiling is not a failure and not a thing to work around. The
    payment is real and somebody with the hardware wallet can make it — so it
    is handed to them as the payment itself, not as a request to widen what
    this Agent may do. A ceiling raised to let one invoice through stays
    raised.
    """
    try:
        d = ask("/send", {"to": address, "usd": usd})
    except SystemExit as stop:
        if stop.code != 2:
            raise
        # Only a shortfall goes to a person. A revoked Agent is not short of
        # headroom, it has no authority at all — and an Agent the chain has
        # cut off has no business putting anything on somebody's screen. The
        # reason is already printed; stop on it.
        if getattr(stop, "status", None) != 402:
            raise
        # ask() has already printed the broker's reason, which names the
        # shortfall. Put the payment itself to whoever holds the device and
        # wait: they see it, the device shows it, they press the button or
        # they do not. Nothing here can make them.
        # Whoever sshed in is on the mesh, and so are we — the broker is not,
        # because the host is deliberately off the tailnet. So the Runner does
        # the asking. The broker only says what to ask for, and checks the
        # answer against the chain afterwards.
        visitor = (os.environ.get("SSH_CLIENT") or "").split(" ")[0]
        got = None

        if visitor:
            print(f"  asking {visitor} — the machine you sshed in from…", file=sys.stderr)
            try:
                plan = ask("/escalate", {"to": address, "usd": usd, "why": why,
                                         "prepare": True})["prepare"]
                signed = post_json(f"http://{visitor}:8799/sign", plan, 360)
                hash_ = (signed.get("result") or {}).get("hash")
                # Second-hand, so checked: a hash is a claim until the chain
                # has it.
                ask("/confirm", {"hash": hash_})
                got = {"paid": f"${usd:g}", "to": address, "by": visitor, "hash": hash_}
            except SystemExit:
                raise
            except Exception as e:
                print(f"  ({visitor} did not sign it: {e})", file=sys.stderr)

        if got is None:
            print("  putting it to the owner's screen instead…", file=sys.stderr)
            try:
                got = ask("/escalate", {"to": address, "usd": usd, "why": why})
            except SystemExit:
                print("  not signed. Nothing moved. Do not retry — ask a person.",
                      file=sys.stderr)
                raise SystemExit(2)

        print(f"the owner signed it: {got['paid']} to {got['to']}")
        if got.get("hash"):
            print(f"  {got['hash']}")
        print("  your own ceiling is unchanged.")
        return

    print(f"sent {d['sent']} to {d['to']}")
    print(f"  {d['hash']}")
    print(f"  {d['left']} left in this window")


def ask_for(want, usd, why=""):
    """Say what you need and stop. This grants nothing and is not meant to."""
    # A shell eats `$20` inside double quotes and leaves "0" behind, so the
    # person reading the request sees an amount that is not the one being
    # approved. Cheap to notice, confusing to discover later.
    if re.search(r"(^|\s)0(\s|$)", want) and usd >= 1:
        print(f"ledger: that reads as {want!r} but you are asking for ${usd:g}.",
              file=sys.stderr)
        print("  Use single quotes and write the amount plainly: "
              f"ledger ask 'send {usd:g} USDC to …' {usd:g} '<why>'", file=sys.stderr)
        raise SystemExit(1)
    d = ask("/ask", {"want": want, "usd": usd, "why": why})
    print(f"recorded as {d['id']}")
    print(f"  {d['note']}")
    print("  Do not retry the action. Wait, or carry on with something else.")


def yields(network=None):
    d = ask("/ledger", {"cmd": "yields", **({"network": network} if network else {})})
    rows = d.get("yields") or []
    # Some rows carry no rate; they are not opportunities, they are noise.
    rated = [y for y in rows if (y.get("interestValue") or "").strip()]
    rated.sort(key=lambda y: -float(y["interestValue"]))
    if not rated:
        print("no rated opportunities")
        return
    print(f"{len(rated)} opportunities, best first:")
    for y in rated:
        rate = float(y["interestValue"]) * 100
        print(f"  {rate:6.2f}% {y.get('interestType','?'):4} {y.get('provider','?'):9} "
              f"{y.get('network','?'):9} {y.get('depositToken','?')}")
        if y.get("deeplink"):
            print(f"           {y['deeplink']}")


def main():
    if len(sys.argv) < 2:
        print(__doc__.strip().split("\n\n")[1])
        raise SystemExit(1)

    what = sys.argv[1]
    if what == "limits":
        limits()
    elif what == "yields":
        yields(sys.argv[2] if len(sys.argv) > 2 else None)
    elif what == "send":
        if len(sys.argv) < 4:
            raise SystemExit("usage: ledger send <address> <usd>")
        try:
            amount = float(sys.argv[3])
        except ValueError:
            raise SystemExit("the amount must be a number of dollars")
        send_to(sys.argv[2], amount, sys.argv[4] if len(sys.argv) > 4 else "")
    elif what == "ask":
        if len(sys.argv) < 4:
            raise SystemExit('usage: ledger ask "<what you need>" <usd> [why]')
        try:
            usd = float(sys.argv[3])
        except ValueError:
            raise SystemExit("the amount must be a number of dollars")
        ask_for(sys.argv[2], usd, sys.argv[4] if len(sys.argv) > 4 else "")
    elif what == "token":
        if len(sys.argv) < 4:
            raise SystemExit("usage: ledger token <network> <address>")
        print(json.dumps(ask("/ledger", {"cmd": "token", "network": sys.argv[2], "address": sys.argv[3]}), indent=2))
    elif what == "token-by-id":
        if len(sys.argv) < 3:
            raise SystemExit("usage: ledger token-by-id <id>")
        print(json.dumps(ask("/ledger", {"cmd": "token-by-id", "id": sys.argv[2]}), indent=2))
    else:
        raise SystemExit(f"ledger: no such command {what!r}")


if __name__ == "__main__":
    main()
