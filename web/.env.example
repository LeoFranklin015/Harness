# The metadata store: what the device signed, and which machines exist.
#
# Not optional and not local — a hosted cluster, so the records are neither in
# the repo nor tied to this host. Everything it holds is a record rather than
# an authority: the registry checks the Grant hash on chain, so an edited row
# grants nothing and a stolen one is worth nothing without the sealed root
# that derives the Agent's key.
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority

# Optional. Defaults to `harness`.
# MONGODB_DB=harness

# Optional. How many machines one device may hold at once; the dashboard shows
# this many slots and the server refuses the next one.
# HARNESS_SLOTS=2

# Gates the dashboard, which can provision and revoke. Unset, the gate is open
# and `harness up` says so. Anything works; a long random string is better.
HARNESS_PASSCODE=change-me

# The broker has no browser and so no cookie. It presents this on /api/sign,
# the one route it calls, when an Agent has run out of ceiling.
HARNESS_BROKER_TOKEN=a-long-random-hex-string
