#!/usr/bin/env python3
"""Approve what an agent asked for, from a machine your Ledger is attached to.

    harness-approve --tenant acme

Run it anywhere — an ssh session on the box is the usual place. It needs no
device of its own and nothing installed: it reads what the agents asked for,
puts the transaction in front of whoever is holding the Ledger, and waits.

Somebody, somewhere, has to be running:

    harness-device-agent --dashboard http://<box>:3000 --tenant acme \\
        --account ethereum-1

That is the machine with the device plugged in. It only makes outbound
requests, so it needs no forwarded port and no ssh flags, and it can be
anybody's laptop.

The device cannot be moved to the shell — wallet-cli reaches a Ledger over
libusb, and the box is a cloud VM whose only USB devices are QEMU's virtual
keyboard and mouse. So the transaction is moved to the device instead.

The bytes signed are the same bytes the dashboard would sign over WebHID. The
device shows them either way, and that is the thing worth checking — not which
program handed them over.

Standard library only.
"""

import argparse
import json
import sys
import urllib.error
import urllib.parse
import urllib.request


def get(url):
    try:
        with urllib.request.urlopen(url, timeout=60) as r:
            return json.loads(r.read())
    except urllib.error.HTTPError as e:
        try:
            raise SystemExit(f"harness-approve: {json.loads(e.read())['error']}")
        except (ValueError, KeyError):
            raise SystemExit(f"harness-approve: HTTP {e.code} from {url}")
    except urllib.error.URLError as e:
        raise SystemExit(f"harness-approve: cannot reach the dashboard ({e.reason})")


def money(n):
    return f"${float(n):.2f}"


def main():
    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    p.add_argument("--dashboard", default="http://localhost:3000", help="where the Harness dashboard is")
    p.add_argument("--tenant", required=True, help="which machine")
    p.add_argument("--registry", default=None, help="override; normally read from the dashboard")
    p.add_argument("--cap", type=float, default=None, help="override; normally read from the dashboard")
    p.add_argument("--days", type=int, default=30)
    p.add_argument("--dry-run", action="store_true", help="prepare and show, do not sign")
    args = p.parse_args()

    base = args.dashboard.rstrip("/")
    answer = get(f"{base}/api/asks?tenant={urllib.parse.quote(args.tenant)}")
    asks = answer.get("asks", [])

    # The dashboard already knows the registry and today's ceiling. Typing
    # them again is two chances to get it wrong for no benefit, so the flags
    # are only there to override.
    known = answer.get("machine") or {}
    if args.registry is None:
        args.registry = known.get("registry")
    if args.cap is None:
        args.cap = known.get("capUsd")
    if known.get("days"):
        args.days = known["days"]

    if not asks:
        print(f"{args.tenant}: nothing waiting.")
        return

    print(f"{args.tenant}: {len(asks)} waiting\n")
    for n, a in enumerate(asks, 1):
        print(f"  {n}. {a['want']}")
        if a.get("why"):
            print(f"     {a['why']}")
        print(f"     {money(a['usd'])}\n")

    try:
        choice = input("approve which? (number, or blank to leave them) ").strip()
    except EOFError:
        # Piped or non-interactive. Listing was still useful; deciding is not
        # something to do on somebody's behalf because stdin ran out.
        print("\n(nothing chosen)")
        return
    if not choice:
        return
    try:
        ask = asks[int(choice) - 1]
    except (ValueError, IndexError):
        raise SystemExit("harness-approve: no such number")

    if args.registry is None or args.cap is None:
        raise SystemExit(
            "harness-approve: the dashboard did not know this machine's registry or ceiling.\n"
            "  Pass --registry and --cap; both are on the machine's card."
        )

    plan = get(
        f"{base}/api/asks/approve?"
        + urllib.parse.urlencode(
            {
                "tenant": args.tenant,
                "id": ask["id"],
                "registry": args.registry,
                "cap": args.cap,
                "days": args.days,
            }
        )
    )

    print(f"\nfrom {plan['from']}")
    print(f"ceiling {money(args.cap)} -> {money(plan['newCapUsd'])}")
    print(f"{len(plan['transactions'])} transaction(s) to sign on the device:\n")
    for t in plan["transactions"]:
        print(f"  {t['what']}")
        print(f"    to   {t['to']}")
        print(f"    data {t['data'][:74]}…\n")

    if args.dry_run:
        print("dry run: nothing signed.")
        return
    for t in plan["transactions"]:
        print(f"waiting for the device: {t['what']}")
        print("  (whoever is holding the Ledger will see this and confirm)")

        body = json.dumps({
            "tenant": args.tenant,
            "to": t["to"],
            "data": t["data"],
            "what": t["what"],
            # Which account must sign. The holder's agent refuses a different
            # device before its screen lights up.
            "expect": plan["from"],
        }).encode()
        req = urllib.request.Request(
            f"{base}/api/sign", data=body, headers={"content-type": "application/json"}
        )
        try:
            with urllib.request.urlopen(req, timeout=330) as r:
                json.loads(r.read())
        except urllib.error.HTTPError as e:
            try:
                why = json.loads(e.read()).get("error", f"HTTP {e.code}")
            except Exception:
                why = f"HTTP {e.code}"
            raise SystemExit(
                f"harness-approve: not signed — {why}\n"
                "  Is harness-device-agent running where the Ledger is?"
            )
        except urllib.error.URLError as e:
            raise SystemExit(f"harness-approve: lost the dashboard ({e.reason})")

    # Only once the chain has it. Forgetting the ask before it is real would
    # leave the agent waiting on something nobody remembers agreeing to.
    urllib.request.urlopen(
        urllib.request.Request(
            f"{base}/api/asks?tenant={urllib.parse.quote(args.tenant)}&id={urllib.parse.quote(ask['id'])}",
            method="DELETE",
        ),
        timeout=30,
    )
    print(f"\napproved. {args.tenant} may now spend up to {money(plan['newCapUsd'])}.")


if __name__ == "__main__":
    main()
