#!/usr/bin/env python3
"""Hold a Ledger for a machine that cannot reach one.

Run this wherever the device is plugged in — your laptop, anyone's laptop.
It watches the dashboard for transactions waiting to be signed, shows you each
one, and signs with wallet-cli when you confirm on the device.

    harness-device-agent --dashboard http://<box>:3000 --tenant acme --account ethereum-1

Then, from anywhere — an ssh session on the box, most likely:

    harness-approve --tenant acme

Nothing is forwarded and nothing listens. This only makes outbound requests,
so it works from behind any firewall, on any machine, with no ssh flags and no
ports opened. That matters more than it sounds: the previous version needed
`ssh -R` and a copy of this repo, which is not something you can hand somebody.

Why it exists at all: wallet-cli reaches a Ledger over libusb, and the box is
a cloud VM whose only USB devices are QEMU's virtual keyboard and mouse. The
device cannot be moved to the shell, so the transaction is moved to the
device.

What it will and will not do:

  - signs only what the dashboard hands it, and prints the bytes first
  - refuses if the account it holds is not the one the machine answers to,
    before the device screen lights up
  - the device still shows the transaction and still needs your button, which
    is the part none of this can route around

Needs python3 and wallet-cli. Nothing else.

    npm i -g @ledgerhq/wallet-cli
    wallet-cli account discover --currency ethereum_sepolia
"""


import argparse
import json
import re
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

WALLET_CLI = "wallet-cli"


def say(line):
    """Print so a person reads it now, not when the buffer happens to fill."""
    print(line, flush=True)


def account_address(account):
    """Which address a session label actually signs from.

    Asked without touching the device — `session view` reads what discovery
    already stored, and `receive --no-verify` resolves an address without
    lighting the screen. Both are cheap, and knowing the answer before the
    device is involved is the difference between refusing a wrong signature
    and confirming one.

    Returns the address, or None if wallet-cli will not say. None is not
    permission: the caller treats it as unverified and says so.
    """
    seen = subprocess.run(
        [WALLET_CLI, "session", "view", "--output", "json"],
        capture_output=True, text=True,
    )
    if seen.returncode == 0:
        found = _find_address(seen.stdout, account)
        if found:
            return found

    # The JSON shape is not contracted to us, so the human output is a real
    # fallback rather than a nicety. It looks like:
    #
    #   ethereum-sepolia-1  account:1:address:ethereum:sepolia:0x2926…:m/44h/60h/0h/0/0
    #
    # An address on the line that names this account is unambiguous enough.
    plain = subprocess.run(
        [WALLET_CLI, "session", "view"], capture_output=True, text=True
    )
    if plain.returncode == 0:
        for line in plain.stdout.splitlines():
            if account in line.split():
                found = _any_address(line)
                if found:
                    return found

    got = subprocess.run(
        [WALLET_CLI, "receive", "--account", account, "--no-verify", "--output", "json"],
        capture_output=True, text=True,
    )
    if got.returncode == 0:
        return _find_address(got.stdout, account) or _any_address(got.stdout)
    return None


def _any_address(blob):
    m = re.search(r"0x[0-9a-fA-F]{40}", blob or "")
    return m.group(0) if m else None


def _find_address(blob, account):
    """Pull the address belonging to one label out of whatever shape it came in.

    wallet-cli's JSON is not contracted to us and has changed shape before, so
    this walks the structure looking for an object that names this account and
    carries an address, rather than trusting a path through it.
    """
    try:
        doc = json.loads(blob)
    except (ValueError, TypeError):
        return None

    hit = []

    def walk(node):
        if isinstance(node, dict):
            labels = {str(node.get(k, "")) for k in ("label", "name", "id", "account")}
            if account in labels:
                for k in ("freshAddress", "address", "receiveAddress"):
                    v = node.get(k)
                    if isinstance(v, str) and re.fullmatch(r"0x[0-9a-fA-F]{40}", v):
                        hit.append(v)
                        return
            for v in node.values():
                walk(v)
        elif isinstance(node, list):
            for v in node:
                walk(v)

    walk(doc)
    return hit[0] if hit else None


def sign_one(job, account):
    """Show a job, sign it if the device agrees, and say what happened."""
    to, data = job["to"], job["data"]
    expect = job.get("expect") or ""

    # Which Ledger, and which account on it. The registry only accepts the
    # tenant's root device, so a signature from the wrong account is a revert
    # somebody has already confirmed on their screen and paid gas for.
    if expect:
        signer = account_address(account)
        if signer is None:
            say(f"\n!! cannot confirm which address {account!r} signs from.")
            say(f"   expected {expect}. Refusing rather than guessing.")
            say("   try: wallet-cli session view")
            return False, f"cannot confirm the address behind {account!r}"
        if signer.lower() != expect.lower():
            say(f"\n!! wrong account. {account!r} is {signer}")
            say(f"   this machine answers to {expect}")
            return False, f"{account!r} is {signer}, not {expect}"

    say(f"\n── asked to sign: {job.get('what', 'a transaction')}")
    say(f"   to     {to}")
    say(f"   data   {data[:78]}{'…' if len(data) > 78 else ''} ({len(data) // 2} bytes)")
    say(f"   as     {account}" + (f" ({expect}) — confirmed the right device" if expect else ""))
    say("   confirm on the device, or reject there to refuse\n")

    done = subprocess.run(
        [WALLET_CLI, "send", "--account", account, "--to", to,
         "--amount", "0 ETH", "--data", data, "--output", "json"],
        capture_output=True, text=True,
    )
    if done.returncode != 0:
        err = (done.stderr or done.stdout or "").strip()[-500:]
        say(f"   refused or failed: {err.splitlines()[-1] if err else 'no output'}")
        return False, err or "wallet-cli failed"

    say("   signed.")
    try:
        return True, json.loads(done.stdout)
    except ValueError:
        return True, {"raw": done.stdout.strip()}


def poll(base, tenant, account):
    """Wait for work, forever, making only outbound requests."""
    while True:
        try:
            with urllib.request.urlopen(
                f"{base}/api/sign/next?tenant={urllib.parse.quote(tenant)}", timeout=40
            ) as r:
                job = json.loads(r.read()).get("job")
        except urllib.error.URLError as e:
            say(f"   (dashboard unreachable: {e.reason}; retrying)")
            time.sleep(5)
            continue
        except Exception:
            # A poll that times out is the normal case, not a problem.
            continue

        if not job:
            continue

        ok, outcome = sign_one(job, account)
        body = json.dumps(
            {"id": job["id"], "ok": ok, **({"result": outcome} if ok else {"error": str(outcome)})}
        ).encode()
        try:
            urllib.request.urlopen(
                urllib.request.Request(
                    f"{base}/api/sign", data=body, method="PUT",
                    headers={"content-type": "application/json"},
                ),
                timeout=30,
            )
        except Exception as e:
            say(f"   could not report the result back: {e}")


def main():
    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    p.add_argument("--dashboard", required=True, help="e.g. http://the-box:3000")
    p.add_argument("--tenant", required=True, help="which machine you are holding the device for")
    p.add_argument("--account", required=True, help="wallet-cli session label, e.g. ethereum-1")
    p.add_argument("--wallet-cli", default="wallet-cli")
    args = p.parse_args()

    global WALLET_CLI
    WALLET_CLI = args.wallet_cli

    found = subprocess.run([WALLET_CLI, "--version"], capture_output=True, text=True)
    if found.returncode != 0:
        raise SystemExit(
            f"harness-device-agent: cannot run {WALLET_CLI!r}.\n"
            "  npm i -g @ledgerhq/wallet-cli"
        )

    base = args.dashboard.rstrip("/")
    say("harness-device-agent — holding a Ledger for " + args.tenant)
    say(f"  dashboard  {base}")
    say(f"  account    {args.account}")
    say(f"  wallet-cli {found.stdout.strip()[:40]}")

    where = account_address(args.account)
    say(f"  address    {where or 'unknown — will refuse anything that names one'}")
    say("\n  outbound only: nothing is listening, nothing is forwarded.")
    say("  waiting for something to sign. ctrl-c to stop.\n")

    poll(base, args.tenant, args.account)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nstopped. the device is no longer held for anything.")
        sys.exit(0)
