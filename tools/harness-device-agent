#!/usr/bin/env python3
"""Hold a Ledger for a machine that cannot reach one.

Run this wherever the device is plugged in — your laptop, anyone's laptop.
It watches the dashboard for transactions waiting to be signed, shows you each
one, and signs with wallet-cli when you confirm on the device.

Two ways to be reachable.

**On the mesh**, which is where a visitor already is:

    harness-device-agent --listen --account ethereum-sepolia-1

The agent pushes the transaction straight to you over Tailscale — it knows
which machine you are because you sshed in from it. Nothing else is involved.

**Or through the dashboard**, for a machine that is not on the mesh:

    harness-device-agent --dashboard http://<box>:3000 --tenant acme --account ethereum-1

Then, from anywhere — an ssh session on the box, most likely:

    harness-approve --tenant acme

Nothing is forwarded and nothing listens. This only makes outbound requests,
so it works from behind any firewall, on any machine, with no ssh flags and no
ports opened. That matters more than it sounds: the previous version needed
`ssh -R` and a copy of this repo, which is not something you can hand somebody.

Why it exists at all: wallet-cli reaches a Ledger over libusb, and the box is
a cloud VM whose only USB devices are QEMU's virtual keyboard and mouse. The
device cannot be moved to the shell, so the transaction is moved to the
device.

What it will and will not do:

  - signs only what the dashboard hands it, and prints the bytes first
  - refuses if the account it holds is not the one the machine answers to,
    before the device screen lights up
  - the device still shows the transaction and still needs your button, which
    is the part none of this can route around

Needs python3 and wallet-cli. Nothing else.

    npm i -g @ledgerhq/wallet-cli
    wallet-cli account discover --currency ethereum_sepolia
"""


import argparse
import json
import re
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

WALLET_CLI = "wallet-cli"


def say(line):
    """Print so a person reads it now, not when the buffer happens to fill."""
    print(line, flush=True)


def account_for(expect):
    """Which session label signs as this address.

    The account cannot be named when ssh config is written — nobody knows yet
    which Ledger will be plugged in, or what wallet-cli will have called it.
    But every job says which address must sign, and wallet-cli says which
    label holds which address, so the two can be matched at the moment it
    matters.
    """
    plain = subprocess.run([WALLET_CLI, "session", "view"], capture_output=True, text=True)
    if plain.returncode != 0:
        return None
    for line in plain.stdout.splitlines():
        found = _any_address(line)
        if found and expect and found.lower() == expect.lower():
            label = line.split()[0] if line.split() else None
            if label:
                return label
    return None


def account_address(account):
    """Which address a session label actually signs from.

    Asked without touching the device — `session view` reads what discovery
    already stored, and `receive --no-verify` resolves an address without
    lighting the screen. Both are cheap, and knowing the answer before the
    device is involved is the difference between refusing a wrong signature
    and confirming one.

    Returns the address, or None if wallet-cli will not say. None is not
    permission: the caller treats it as unverified and says so.
    """
    seen = subprocess.run(
        [WALLET_CLI, "session", "view", "--output", "json"],
        capture_output=True, text=True,
    )
    if seen.returncode == 0:
        found = _find_address(seen.stdout, account)
        if found:
            return found

    # The JSON shape is not contracted to us, so the human output is a real
    # fallback rather than a nicety. It looks like:
    #
    #   ethereum-sepolia-1  account:1:address:ethereum:sepolia:0x2926…:m/44h/60h/0h/0/0
    #
    # An address on the line that names this account is unambiguous enough.
    plain = subprocess.run(
        [WALLET_CLI, "session", "view"], capture_output=True, text=True
    )
    if plain.returncode == 0:
        for line in plain.stdout.splitlines():
            if account in line.split():
                found = _any_address(line)
                if found:
                    return found

    got = subprocess.run(
        [WALLET_CLI, "receive", "--account", account, "--no-verify", "--output", "json"],
        capture_output=True, text=True,
    )
    if got.returncode == 0:
        return _find_address(got.stdout, account) or _any_address(got.stdout)
    return None


def _find_hash(node):
    """A 32-byte hex string, from any shape. Ledger nests it differently."""
    if isinstance(node, str):
        m = re.search(r"0x[0-9a-fA-F]{64}", node)
        return m.group(0) if m else None
    if isinstance(node, dict):
        # Prefer a field that says what it is, before falling back to shape.
        for k in ("hash", "transactionHash", "txHash", "id"):
            v = node.get(k)
            if isinstance(v, str) and re.fullmatch(r"0x[0-9a-fA-F]{64}", v):
                return v
        for v in node.values():
            got = _find_hash(v)
            if got:
                return got
    elif isinstance(node, list):
        for v in node:
            got = _find_hash(v)
            if got:
                return got
    return None


def _any_address(blob):
    m = re.search(r"0x[0-9a-fA-F]{40}", blob or "")
    return m.group(0) if m else None


def _find_address(blob, account):
    """Pull the address belonging to one label out of whatever shape it came in.

    wallet-cli's JSON is not contracted to us and has changed shape before, so
    this walks the structure looking for an object that names this account and
    carries an address, rather than trusting a path through it.
    """
    try:
        doc = json.loads(blob)
    except (ValueError, TypeError):
        return None

    hit = []

    def walk(node):
        if isinstance(node, dict):
            labels = {str(node.get(k, "")) for k in ("label", "name", "id", "account")}
            if account in labels:
                for k in ("freshAddress", "address", "receiveAddress"):
                    v = node.get(k)
                    if isinstance(v, str) and re.fullmatch(r"0x[0-9a-fA-F]{40}", v):
                        hit.append(v)
                        return
            for v in node.values():
                walk(v)
        elif isinstance(node, list):
            for v in node:
                walk(v)

    walk(doc)
    return hit[0] if hit else None


def sign_one(job, account):
    """Show a job, sign it if the device agrees, and say what happened."""
    to, data = job["to"], job["data"]
    expect = job.get("expect") or ""

    # No account named: find the one that signs as the address this job wants.
    if not account:
        account = account_for(expect)
        if not account:
            say(f"\n!! no account here signs as {expect}.")
            say("   plug in the right Ledger, or run: wallet-cli account discover")
            return False, f"no account on this machine signs as {expect}"

    # Which Ledger, and which account on it. The registry only accepts the
    # tenant's root device, so a signature from the wrong account is a revert
    # somebody has already confirmed on their screen and paid gas for.
    if expect:
        signer = account_address(account)
        if signer is None:
            say(f"\n!! cannot confirm which address {account!r} signs from.")
            say(f"   expected {expect}. Refusing rather than guessing.")
            say("   try: wallet-cli session view")
            return False, f"cannot confirm the address behind {account!r}"
        if signer.lower() != expect.lower():
            say(f"\n!! wrong account. {account!r} is {signer}")
            say(f"   this machine answers to {expect}")
            return False, f"{account!r} is {signer}, not {expect}"

    # A named token transfer where the signer can resolve the token: fees get
    # estimated and the device shows what it is, rather than bytes.
    recipient = job.get("recipient")
    amount = job.get("amount")

    say(f"\n── asked to sign: {job.get('what', 'a transaction')}")
    if recipient and amount:
        say(f"   send   {amount}")
        say(f"   to     {recipient}")
    else:
        say(f"   to     {to}")
        say(f"   data   {data[:78]}{'…' if len(data) > 78 else ''} ({len(data) // 2} bytes)")
    say(f"   as     {account}" + (f" ({expect}) — confirmed the right device" if expect else ""))
    say("   confirm on the device, or reject there to refuse\n")

    if recipient and amount:
        cmd = [WALLET_CLI, "send", "--account", account, "--to", recipient,
               "--amount", amount, "--output", "json"]
    else:
        cmd = [WALLET_CLI, "send", "--account", account, "--to", to,
               "--amount", "0 ETH", "--data", data, "--output", "json"]

    done = subprocess.run(cmd, capture_output=True, text=True)
    if done.returncode != 0:
        err = (done.stderr or done.stdout or "").strip()[-500:]
        say(f"   refused or failed: {err.splitlines()[-1] if err else 'no output'}")
        return False, err or "wallet-cli failed"

    say("   signed.")
    try:
        answer = json.loads(done.stdout)
    except ValueError:
        answer = {"raw": done.stdout.strip()}

    # Find the transaction hash wherever wallet-cli happens to put it.
    #
    # Its JSON is not contracted to us and nests differently per command, and
    # reading a fixed path meant a real signature came back looking like no
    # signature at all — the money moved and the agent was told it had not,
    # which is the worst of the three possible answers.
    found = _find_hash(answer) or _find_hash(done.stdout)
    if found:
        answer = dict(answer) if isinstance(answer, dict) else {"raw": answer}
        answer["hash"] = found
    else:
        say("   (signed, but no transaction hash in the output — see below)")
        say(f"   {done.stdout.strip()[:300]}")
    return True, answer


def tailnet_address():
    """This machine's address on the mesh, or None if it is not on one."""
    for cli in ("tailscale", "/Applications/Tailscale.app/Contents/MacOS/Tailscale"):
        got = subprocess.run([cli, "ip", "-4"], capture_output=True, text=True)
        if got.returncode == 0 and got.stdout.strip():
            return got.stdout.strip().splitlines()[0].strip()
    return None


def listen(account, port):
    """Wait on the mesh for an agent to hand over a transaction.

    Bound to the tailnet address alone, never 0.0.0.0 — a laptop's other
    networks are somebody's cafe wifi, and a thing that signs should not be
    listening there. On the mesh the tailnet's own policy decides who may
    reach this at all, which is the same policy that lets you reach the agent.
    """
    from http.server import BaseHTTPRequestHandler, HTTPServer

    where = tailnet_address()
    if not where:
        raise SystemExit(
            "harness-device-agent: this machine is not on the mesh, so nothing can reach it.\n"
            "  Join it, or use --dashboard instead."
        )

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *_):
            pass

        def _reply(self, status, body):
            raw = json.dumps(body).encode()
            self.send_response(status)
            self.send_header("content-type", "application/json")
            self.send_header("content-length", str(len(raw)))
            self.end_headers()
            self.wfile.write(raw)

        def do_GET(self):
            self._reply(200 if self.path == "/health" else 404, {"ok": self.path == "/health"})

        def do_POST(self):
            if self.path != "/sign":
                return self._reply(404, {"error": "not found"})
            n = int(self.headers.get("content-length") or 0)
            try:
                job = json.loads(self.rfile.read(n) or b"{}")
            except ValueError:
                return self._reply(400, {"error": "expected JSON"})
            # The pusher does not know our session label; we do.
            ok, outcome = sign_one(job, account)
            self._reply(200 if ok else 502,
                        {"result": outcome} if ok else {"error": str(outcome)})

    try:
        server = HTTPServer((where, port), Handler)
    except OSError as e:
        # Already holding the device from an earlier ssh. Starting a second
        # copy is not an error worth shouting about — it is the normal case
        # when ssh config starts this on every connection.
        if getattr(e, "errno", None) in (48, 98):  # EADDRINUSE, mac and linux
            say(f"  already holding the device on {where}:{port} — nothing to do.")
            return
        raise

    say(f"  listening on {where}:{port} — the mesh only, not this laptop's other networks")
    say("  waiting for an agent to hand something over. ctrl-c to stop.\n")
    server.serve_forever()


def poll(base, tenant, account):
    """Wait for work, forever, making only outbound requests."""
    while True:
        try:
            with urllib.request.urlopen(
                f"{base}/api/sign/next?tenant={urllib.parse.quote(tenant)}", timeout=40
            ) as r:
                job = json.loads(r.read()).get("job")
        except urllib.error.URLError as e:
            say(f"   (dashboard unreachable: {e.reason}; retrying)")
            time.sleep(5)
            continue
        except Exception:
            # A poll that times out is the normal case, not a problem.
            continue

        if not job:
            continue

        ok, outcome = sign_one(job, account)
        body = json.dumps(
            {"id": job["id"], "ok": ok, **({"result": outcome} if ok else {"error": str(outcome)})}
        ).encode()
        try:
            urllib.request.urlopen(
                urllib.request.Request(
                    f"{base}/api/sign", data=body, method="PUT",
                    headers={"content-type": "application/json"},
                ),
                timeout=30,
            )
        except Exception as e:
            say(f"   could not report the result back: {e}")


def main():
    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    p.add_argument("--listen", action="store_true",
                   help="wait on the mesh; the agent pushes straight to you")
    p.add_argument("--port", type=int, default=8799, help="with --listen")
    p.add_argument("--dashboard", help="e.g. http://the-box:3000, if you are not on the mesh")
    p.add_argument("--tenant", help="which machine you are holding the device for (with --dashboard)")
    p.add_argument("--account", default=None,
                   help="wallet-cli session label; omitted, the one matching each request is used")
    p.add_argument("--wallet-cli", default="wallet-cli")
    args = p.parse_args()

    global WALLET_CLI
    WALLET_CLI = args.wallet_cli

    try:
        found = subprocess.run([WALLET_CLI, "--version"], capture_output=True, text=True)
    except OSError:
        # Not on PATH at all, which is a different thing from failing to run
        # and deserves the same one-line answer rather than a traceback.
        raise SystemExit(
            f"harness-device-agent: {WALLET_CLI!r} is not installed here.\n"
            "  npm i -g @ledgerhq/wallet-cli"
        )
    if found.returncode != 0:
        raise SystemExit(
            f"harness-device-agent: cannot run {WALLET_CLI!r}.\n"
            "  npm i -g @ledgerhq/wallet-cli"
        )

    if not args.listen and not (args.dashboard and args.tenant):
        raise SystemExit(
            "harness-device-agent: use --listen (on the mesh), or --dashboard with --tenant."
        )

    say("harness-device-agent — holding a Ledger")
    if args.dashboard:
        say(f"  dashboard  {args.dashboard.rstrip('/')}")
    say(f"  account    {args.account or 'whichever matches each request'}")
    say(f"  wallet-cli {found.stdout.strip()[:40]}")

    if args.account:
        seen = account_address(args.account)
        say(f"  address    {seen or 'unknown — will refuse anything that names one'}")
    if args.listen:
        listen(args.account, args.port)
    else:
        say("\n  outbound only: nothing is listening, nothing is forwarded.")
        say("  waiting for something to sign. ctrl-c to stop.\n")
        poll(args.dashboard.rstrip("/"), args.tenant, args.account)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nstopped. the device is no longer held for anything.")
        sys.exit(0)
